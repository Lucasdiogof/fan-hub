# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Keystore de release Android — NUNCA versionar o arquivo nem as senhas.
# Ver android/key.properties.example pro formato esperado.
/android/key.properties
*.jks
*.keystore

# Cloudflare Pages Functions
/node_modules/
.dev.vars
.wrangler/

# Python / Scweet
__pycache__/
*.py[cod]
.venv/
venv/

# Scratchpad de docs/temporários gerados durante o desenvolvimento
scratchpad/

# Cache/estado local do Supabase CLI (supabase link/db etc.) — inclui a
# connection string do Postgres COM SENHA em texto puro (.temp/pooler-url).
# Nunca deve ir pro git.
supabase/.temp/

# Segredos locais (token do X, chaves de teste). Nunca versionar.
.env
.env.*
!.env.example

# Estado local da Scweet: a tabela `accounts` guarda auth_token, csrf e
# cookies da sessão do X. Nunca versionar.
scweet_state.db

# Cache de respostas HTTP do coletor de competições (~129 MB). O código do
# coletor é versionado; o cache é reconstruível e inflaria o repositório
# pra sempre, porque histórico de git não se apaga.
_competitions_pkg/**/.cache/

# Concatenação de migrations pra leitura. Os 9 arquivos já existem em
# archive/supabase/goias-legacy-migrations/files/ — é cópia, não fonte.
migration_dump.txt
