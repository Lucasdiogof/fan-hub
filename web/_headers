# Security and cache headers for the Static Assets of every club (Flutter copies web/ into each build). Max 100 rules on the Free plan.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  # Revalidate by default (ETag): Flutter's entry files are NOT content-hashed,
  # so long caching would pin users to an old build. Cheap: asset requests are free.
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
