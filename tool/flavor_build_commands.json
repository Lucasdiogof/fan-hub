{
  "android": {
    "goias": "flutter build apk --flavor goias --dart-define=APP_CLUB=goias",
    "bragantino": "flutter build apk --flavor bragantino --dart-define=APP_CLUB=bragantino"
  },
  "ios": {
    "goias": "flutter build ios --flavor goias --dart-define=APP_CLUB=goias --no-codesign",
    "bragantino": "flutter build ios --flavor bragantino --dart-define=APP_CLUB=bragantino --no-codesign"
  },
  "web": {
    "goias": "node tool/build_web_flavor.mjs goias",
    "bragantino": "node tool/build_web_flavor.mjs bragantino"
  }
}
